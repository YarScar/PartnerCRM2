generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PartnerStatus {
  id         Int    @id @default(autoincrement())
  label      String @unique
  color      String
  sort_order Int    @default(0)

  @@map("partner_statuses")
}

model Partner {
  id                        Int      @id @default(autoincrement())
  org_name                  String
  contact_name              String?
  contact_email             String?
  contact_phone             String?
  contact_role              String?
  org_website               String?
  org_address               String?
  org_city                  String?
  org_state                 String?
  status                    String   @default("New")
  program_structure         String?
  who_they_work_with        String?
  youth_ages                String?
  how_kids_connect          String?
  intake_message            String?
  recruitment_needed        Boolean?
  recruitment_notes         String?
  program_times             String?
  schedule_flexibility      String?
  desired_program_type      String?
  specific_project_request  String?
  wants_recommendations     Boolean  @default(false)
  desired_timeline          String?
  firm_dates                String?
  works_with_3d_tech        String?
  three_d_tech_specifics    String?
  hardware_inventory        Json?
  hardware_notes            String?
  available_computers       String?
  internet_availability     String?
  available_space           String?
  on_site_assistance        Boolean?
  on_site_assistance_notes  String?
  accessibility_limitations String?
  general_tech_context      String?
  source                    String?  @default("manual")
  properties                Json?
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @updatedAt @db.Timestamptz(6)

  notes PartnerNote[]
  runs  ProgramRun[]

  @@index([status], map: "idx_partners_status")
  @@index([created_at(sort: Desc)], map: "idx_partners_created_at")
  @@map("partners")
}

model PartnerNote {
  id         Int      @id @default(autoincrement())
  partner_id Int
  body       String
  author     String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  partner Partner @relation(fields: [partner_id], references: [id], onDelete: Cascade)

  @@index([partner_id], map: "idx_partner_notes_partner_id")
  @@map("partner_notes")
}

model User {
  id                        Int                      @id @default(autoincrement())
  username                  String                   @unique
  email                     String?                  @unique
  password_hash             String
  display_name              String
  email_verified            Boolean                  @default(false)
  pending_email             String?
  role                      String                   @default("staff")
  must_change_password      Boolean                  @default(false)
  created_at                DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                 @updatedAt @db.Timestamptz(6)
  password_reset_tokens     PasswordResetToken[]
  email_verification_tokens EmailVerificationToken[]

  @@index([username], map: "idx_users_username")
  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model FormConfig {
  id            Int      @id @default(autoincrement())
  section_key   String
  section_label String
  field_key     String
  field_label   String
  field_type    String
  options       Json?
  visible       Boolean? @default(true)
  required      Boolean? @default(false)
  sort_order    Int?     @default(0)

  @@unique([section_key, field_key])
  @@map("form_config")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// A program is the reusable idea (e.g. "Intro to 3D Printing"). Each time it actually
// happens is a ProgramRun, which can be with a partner and can differ from the plan.
model Program {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  goals          String[] @default([])
  age_min        Int?
  age_max        Int?
  audience_notes String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  runs       ProgramRun[]
  activities ProgramActivity[]

  @@map("programs")
}

// One time a program happened (or will). Starts with the program's activity plan,
// then gets changed for this audience; what_changed records how it differed.
model ProgramRun {
  id                Int       @id @default(autoincrement())
  program_id        Int
  partner_id        Int?
  name              String
  status            String    @default("Planned")
  start_date        DateTime? @db.Date
  end_date          DateTime? @db.Date
  location          String?
  age_min           Int?
  age_max           Int?
  participant_count Int?
  what_changed      String?
  notes             String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  program    Program       @relation(fields: [program_id], references: [id], onDelete: Cascade)
  partner    Partner?      @relation(fields: [partner_id], references: [id], onDelete: SetNull)
  activities RunActivity[]

  @@index([program_id], map: "idx_program_runs_program_id")
  @@index([partner_id], map: "idx_program_runs_partner_id")
  @@map("program_runs")
}

// The activity library. based_on_id links a twist back to the activity it came from.
model Activity {
  id               Int      @id @default(autoincrement())
  name             String
  summary          String?
  category         String?
  goals            String[] @default([])
  age_min          Int?
  age_max          Int?
  duration_minutes Int?
  group_size       String?
  materials        String?
  instructions     String?
  based_on_id      Int?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  based_on Activity?         @relation("ActivityVariants", fields: [based_on_id], references: [id], onDelete: SetNull)
  variants Activity[]        @relation("ActivityVariants")
  programs ProgramActivity[]
  runs     RunActivity[]

  @@index([based_on_id], map: "idx_activities_based_on_id")
  @@map("activities")
}

// A program's usual activity plan, in order.
model ProgramActivity {
  id          Int @id @default(autoincrement())
  program_id  Int
  activity_id Int
  sort_order  Int @default(0)

  program  Program  @relation(fields: [program_id], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@unique([program_id, activity_id])
  @@map("program_activities")
}

// What one run actually did, in order, with how it was adapted this time. An activity
// a run used cannot be deleted, so the history of past runs stays whole.
model RunActivity {
  id          Int     @id @default(autoincrement())
  run_id      Int
  activity_id Int
  sort_order  Int     @default(0)
  notes       String?

  run      ProgramRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  activity Activity   @relation(fields: [activity_id], references: [id], onDelete: Restrict)

  @@index([run_id], map: "idx_run_activities_run_id")
  @@map("run_activities")
}
