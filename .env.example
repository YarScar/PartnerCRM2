# Get this from your Neon dashboard: https://console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# When DATABASE_URL is empty, local dev falls back to mock data. Production refuses
# to run without it (otherwise intake submissions would be held in memory and lost).

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session / security — signs login cookies. Required in production, at least 32
# random characters (e.g. `openssl rand -hex 32`). Changing it signs everyone out.
AUTH_SECRET=

# Accounts created by `npm run db:seed`. Dev defaults only — set strong passwords
# before seeding any real database.
ADMIN_ACCOUNT_USERNAME=admin
ADMIN_ACCOUNT_PASSWORD=admin123
STAFF_ACCOUNT_USERNAME=staff
STAFF_ACCOUNT_PASSWORD=staff123

# --- Notifications ---
# New-intake emails and the weekly digest go to every admin with a verified email
# (Settings → verify email) plus this comma-separated list. Use a shared inbox here
# so notifications keep arriving when staff change.
NOTIFICATION_EMAILS=

# --- Email (Resend) ---
# API key for Resend: https://resend.com
RESEND_API_KEY=
# Sender. Must be on a domain verified in Resend (Domains → Add domain), e.g.
#   EMAIL_FROM="CreateAccess <notifications@yourdomain.org>"
# Left empty, local dev uses Resend's test sender, which only delivers to the
# Resend account owner's own address. Production refuses to send without it.
EMAIL_FROM=

# --- Weekly digest (Vercel Cron, vercel.json) ---
# Any long random string (e.g. `openssl rand -hex 32`). Vercel sends it to the
# cron route automatically; without it the scheduled digest is refused.
CRON_SECRET=

 