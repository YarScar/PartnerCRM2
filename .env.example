# Copy to .env.local (never commit it). The fastest way to fill it in:
#   npx vercel link && npx vercel env pull .env.local
# then add your own DATABASE_URL (see below).

# ============================================================
# 1. REQUIRED on every laptop
# ============================================================

# The database. Use your own Neon *dev branch*, never production:
# Neon → your project → Branches → New branch → copy the connection string.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Signs login cookies. Any random string, 32+ characters: `openssl rand -hex 32`
# Each laptop can have its own. In production, changing it signs everyone out.
AUTH_SECRET=

# The app's own address (used in links inside emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# 2. OPTIONAL — only to test emails locally
# ============================================================

# Resend → API Keys → Create (one key per person/laptop).
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. "CreateAccess <notifications@yourdomain.org>".
# While it's empty, emails come from Resend's test sender, which only delivers to
# the Resend account owner's address. Set it once a domain is verified.
EMAIL_FROM=
# Who gets new-intake emails (comma-separated), in addition
# to every admin with a verified email. In production, use a shared inbox.
NOTIFICATION_EMAILS=

# ============================================================
# OPTIONAL — show Jira tasks on programs (read-only)
# ============================================================

# Your Jira site, e.g. https://yourteam.atlassian.net
JIRA_BASE_URL=
# A Jira account that can see the tasks, and its API token
# (id.atlassian.com → Security → API tokens). The app only reads.
JIRA_EMAIL=
JIRA_API_TOKEN=

# ============================================================
# 3. ONLY when filling an empty database (`npm run db:seed`)
# ============================================================

# The starting admin and staff logins the seed creates. Dev defaults only:
# use strong passwords before seeding any real database.
ADMIN_ACCOUNT_USERNAME=admin
ADMIN_ACCOUNT_PASSWORD=admin123
STAFF_ACCOUNT_USERNAME=staff
STAFF_ACCOUNT_PASSWORD=staff123
